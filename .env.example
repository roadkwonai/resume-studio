# Resume Studio에서 생성하는 독립 프로젝트의 환경 변수 예시입니다.
# 아래 값은 예시이며 루트에 입력해도 생성된 프로젝트에 자동 전달되지 않습니다.
# 문의 기능 구현 후 독립 프로젝트의 .env.example을 .env.local로 복사해 설정하세요.

# 이 파일은 예시입니다. cp .env.example .env.local 로 복사한 뒤
# 선택한 기능에 필요한 값만 채우세요. 실제 키를 이 파일이나 Git에 넣지 마세요.
# 예시 변수는 기능을 자동으로 설치하거나 활성화하지 않습니다.

# Gmail 문의 메일을 구현한 경우에만 사용합니다.
# 발신 Gmail 계정과 수신 주소는 구현에 맞게 설정합니다.
# Google 계정의 2단계 인증 후 앱 비밀번호를 발급하세요.
# https://support.google.com/accounts/answer/185833
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=

# Resend를 구현한 경우에만 사용합니다. 일반 외부 수신자에게 보내려면
# 인증된 발신 도메인이 필요합니다. https://resend.com/docs/dashboard/domains/introduction
RESEND_API_KEY=
# 인증한 도메인의 발신 주소 (예: contact@example.com)
RESEND_FROM_EMAIL=

# Vercel CLI의 토큰 인증이 필요할 때 로컬에서만 사용합니다.
# https://vercel.com/docs/rest-api/reference/authentication
# Vercel 애플리케이션의 공개 환경변수에 등록하지 마세요.
VERCEL_TOKEN=
